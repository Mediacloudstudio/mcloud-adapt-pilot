// ─────────────────────────────────────────────────────────────────────────
// MCloud Adapt Pilot — Prisma Schema
// MediaCloud Studio Pvt Ltd
//
// This schema implements the domain model from the product spec (PART 54)
// with the following deliberate additions over the original spec — see
// docs/ARCHITECTURE.md section "Suggested modifications" for the reasoning:
//
//   1. Enums instead of free-text status strings, so invalid states are
//      impossible at the database layer.
//   2. A TemplateCategory lookup table instead of a hardcoded enum, so
//      admins can add new categories (e.g. "DIGITAL_OOH") without a
//      code deployment or migration.
//   3. NextAuth-compatible Account/Session tables included now (unused by
//      Phase 3's credentials flow) so Google/Microsoft SSO is a config
//      change later, not a schema migration.
//   4. Separate EmailVerificationToken / PasswordResetToken tables instead
//      of NextAuth's generic VerificationToken, for branded emails and
//      independent expiry rules.
//   5. `User.sessionVersion` — bumped on password change / admin suspend,
//      checked on every JWT refresh, so access can be revoked instantly
//      without database-backed sessions.
//   6. Money fields use `Decimal(12,2)`, never float, to avoid rounding
//      errors in billing.
//   7. `licenses.licenseKeyHash` stores a SHA-256 hash; the human-readable
//      `displayKey` (MCAP-XXXX-XXXX-XXXX) is shown in the UI, but the
//      value that is actually verified server-side is never stored in
//      reversible form.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────── ENUMS ──────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
  CUSTOM
}

// PART 28 — internal subscription state, independent of raw Razorpay status.
enum SubscriptionStatus {
  TRIAL
  PENDING_PAYMENT
  ACTIVE
  PAYMENT_ISSUE
  GRACE_PERIOD
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum UpgradeStrategy {
  PRICE_DIFFERENCE
  PRORATED_DIFFERENCE
  FULL_REPLACEMENT_PRICE
  ADMIN_DEFINED_AMOUNT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RazorpayEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum DeviceStatus {
  ACTIVE
  DEACTIVATED
  BLOCKED
}

enum LicenseEventType {
  ACTIVATED
  VALIDATED
  DEACTIVATED
  RESET
  SUSPENDED
  REACTIVATED
  REVOKED
  BLOCKED
  DEVICE_LIMIT_REJECTED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FeatureFlagScope {
  GLOBAL
  PLAN
  COMPANY
}

enum JobStatus {
  PROCESSING
  DONE
  ERROR
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

enum AppPlatform {
  WINDOWS
  MACOS // reserved for future (PART 67)
}

// ────────────────────────────── IDENTITY ───────────────────────────────

model User {
  id                String       @id @default(cuid())
  firstName         String
  lastName          String
  email             String       @unique
  passwordHash      String
  emailVerified     DateTime?
  phone             String?
  status            UserStatus   @default(INVITED)
  // Bumped on password change or admin-initiated suspend/force-logout;
  // compared against the value embedded in each JWT (see src/lib/auth.ts).
  sessionVersion    Int          @default(0)
  // MediaCloud internal staff flag (PART 42 — "completely separate admin
  // interface"). Deliberately NOT the same thing as company role
  // COMPANY_ADMIN — that role is scoped to one customer company and
  // grants zero admin-portal access. An admin user typically has no
  // CompanyUser membership at all.
  isPlatformAdmin   Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  companyMemberships CompanyUser[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  supportReplies       SupportTicketReply[]
  jobs                 Job[]
  accounts             Account[]
  sessions             Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

// NextAuth-compatible tables, unused by the Phase 3 Credentials flow but
// present now so Google/Microsoft SSO (PART: "structure so SSO can be
// added later") only requires enabling a provider, not a migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ────────────────────────────── COMPANY / RBAC ─────────────────────────

model Company {
  id            String        @id @default(cuid())
  companyName   String
  legalName     String?
  gstin         String?
  billingAddress String?
  state         String?
  pinCode       String?
  country       String        @default("India")
  status        CompanyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users              CompanyUser[]
  subscriptions      Subscription[]
  razorpayCustomer   RazorpayCustomer?
  payments           Payment[]
  licenses           License[]
  devices            Device[]
  customerTemplates  CustomerTemplate[]
  jobs               Job[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  supportTickets     SupportTicket[]
  featureFlags       FeatureFlag[]
  planOverride       CompanyPlanOverride?

  @@map("companies")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "Company Admin" | "Designer" | "Billing Admin" | ...
  code        String   @unique // "COMPANY_ADMIN" | "DESIGNER" | "BILLING_ADMIN"
  description String?
  isSystem    Boolean  @default(true) // system roles cannot be deleted from the admin UI

  companyUsers    CompanyUser[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // e.g. "billing.view", "devices.manage", "templates.assign"
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CompanyUser {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@map("company_users")
}

// ────────────────────────────── PLANS / SUBSCRIPTIONS ──────────────────

model Plan {
  id               String            @id @default(cuid())
  code             String            @unique // "PLAN_1PC" | "PLAN_2PC" | "PLAN_3PC"
  name             String            // "1 PC Plan"
  description      String?
  price            Decimal           @db.Decimal(12, 2)
  currency         String            @default("INR")
  billingFrequency BillingFrequency  @default(ANNUAL)
  deviceLimit      Int
  razorpayPlanId   String?
  isRecommended    Boolean           @default(false)
  sortOrder        Int               @default(0)
  status           PlanStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
  featureFlags  FeatureFlag[]

  @@map("plans")
}

model PlanFeature {
  id          String  @id @default(cuid())
  planId      String
  featureCode String  // e.g. "desktop_app", "usage_dashboard", "support"
  label       String  // display label shown on the pricing page
  enabled     Boolean @default(true)
  value       String? // optional free-text value, e.g. a limit

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@map("plan_features")
}

// Enterprise / custom pricing overrides (PART 46). Kept separate from
// Plan so standard plan pricing stays simple while still allowing
// per-company overrides that are fully audited.
model CompanyPlanOverride {
  id                String   @id @default(cuid())
  companyId         String   @unique
  customPrice       Decimal? @db.Decimal(12, 2)
  customDeviceLimit Int?
  isComplimentary   Boolean  @default(false)
  extendedTrialUntil DateTime?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_plan_overrides")
}

model Subscription {
  id                  String             @id @default(cuid())
  companyId           String
  planId              String
  status              SubscriptionStatus @default(PENDING_PAYMENT)
  upgradeStrategy      UpgradeStrategy    @default(PRORATED_DIFFERENCE)
  startDate           DateTime?
  nextBillingDate      DateTime?
  endDate              DateTime?
  graceEndDate          DateTime?
  gracePeriodDays       Int                @default(3)
  cancelAtPeriodEnd     Boolean            @default(false)
  pendingDowngradePlanId String?
  razorpaySubscriptionId String?           @unique
  razorpayOrderId        String?
  createdAt              DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
  licenses License[]
  invoices Invoice[]

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model RazorpayCustomer {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  razorpayCustomerId String   @unique
  createdAt          DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("razorpay_customers")
}

// ────────────────────────────── PAYMENTS / BILLING ─────────────────────

model Payment {
  id                 String        @id @default(cuid())
  companyId          String
  subscriptionId     String?
  razorpayPaymentId  String?       @unique
  razorpayOrderId    String?
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  failureReason       String?
  paymentDate          DateTime?
  createdAt             DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?
  refunds      Refund[]
  razorpayEvents RazorpayEvent[]

  @@index([companyId])
  @@index([status])
  @@map("payments")
}

// PART 29 — idempotent webhook processing ledger.
model RazorpayEvent {
  id               String              @id @default(cuid())
  eventId          String              @unique // Razorpay's x-razorpay-event-id
  eventType        String
  payloadReference String?             // storage key/id of the raw payload, not the raw payload itself
  status           RazorpayEventStatus @default(RECEIVED)
  companyId        String?
  subscriptionId   String?
  paymentId        String?
  error            String?
  receivedAt       DateTime            @default(now())
  processedAt      DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([eventType])
  @@index([status])
  @@map("razorpay_events")
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  razorpayRefundId String?      @unique
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  subscriptionId String?
  paymentId      String?       @unique
  invoiceNumber  String        @unique
  customerGstin  String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2) @default(0)
  taxBreakdown   Json?         // e.g. { "CGST": 900, "SGST": 900 } — configurable, never hard-coded
  total          Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  invoiceDate    DateTime      @default(now())
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([companyId])
  @@map("invoices")
}

// ────────────────────────────── LICENSING / DEVICES ─────────────────────

model License {
  id                   String        @id @default(cuid())
  companyId            String
  subscriptionId       String?
  licenseKeyHash       String        @unique // SHA-256 hash of the real key; never store it reversibly
  displayKey           String        @unique // "MCAP-XXXX-XXXX-XXXX" masked/partial form shown in UI
  status               LicenseStatus @default(ACTIVE)
  deviceLimitOverride  Int?          // admin override independent of the plan's device limit
  validUntil           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  devices      Device[]
  events       LicenseEvent[]

  @@index([companyId])
  @@map("licenses")
}

model Device {
  id              String       @id @default(cuid())
  licenseId       String
  companyId       String
  deviceId        String       // client-generated stable identifier
  fingerprintHash String       // hashed machine fingerprint, not stored raw
  deviceName      String?      // e.g. "DESIGN-PC-01"
  computerName    String?
  os               String?
  appVersion       String?
  status            DeviceStatus @default(ACTIVE)
  activatedAt       DateTime     @default(now())
  deactivatedAt      DateTime?
  lastSeenAt          DateTime?
  createdAt             DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  license License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  LicenseEvent[]
  jobs    Job[]

  @@unique([licenseId, deviceId])
  @@index([companyId])
  @@index([status])
  @@map("devices")
}

model LicenseEvent {
  id        String           @id @default(cuid())
  licenseId String
  deviceId  String?
  event     LicenseEventType
  detail    String?
  ipAddress String?
  createdAt DateTime         @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  device  Device? @relation(fields: [deviceId], references: [id])

  @@index([licenseId])
  @@map("license_events")
}

// ────────────────────────────── TEMPLATES ────────────────────────────────

// A lookup table rather than an enum — PART 38 explicitly asks to "prepare
// for future categories"; a table lets admins add one without a migration.
model TemplateCategory {
  id        String   @id @default(cuid())
  code      String   @unique // "INSTORE" | "OUTDOOR" | "STATIC" ...
  label     String
  sortOrder Int      @default(0)

  templates Template[]

  @@map("template_categories")
}

model Template {
  id           String         @id @default(cuid())
  name         String
  categoryId   String
  version      String         @default("1.0.0")
  thumbnailUrl String?
  description  String?
  requiredPlanId String?
  status       TemplateStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category          TemplateCategory   @relation(fields: [categoryId], references: [id])
  customerTemplates CustomerTemplate[]
  jobs              Job[]

  @@index([categoryId])
  @@map("templates")
}

model CustomerTemplate {
  id         String   @id @default(cuid())
  companyId  String
  templateId String
  grantedAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([companyId, templateId])
  @@map("customer_templates")
}

// ────────────────────────────── APPLICATION CONTROL ──────────────────────

model AppVersion {
  id                  String      @id @default(cuid())
  version             String      @unique
  minimumSupportedVersion String
  platform            AppPlatform @default(WINDOWS)
  installerUrl         String
  installerFileName     String?
  releaseNotes            String?     @db.Text
  mandatory                Boolean     @default(false)
  publishedAt               DateTime    @default(now())
  createdAt                   DateTime    @default(now())

  @@map("app_versions")
}

model AppSetting {
  key   String @id
  value Json

  @@map("app_settings")
}

model Banner {
  id        String       @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  startDate DateTime?
  endDate   DateTime?
  status    BannerStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("banners")
}

model FeatureFlag {
  id        String           @id @default(cuid())
  code      String           // "enable_batch_processing", etc.
  scope     FeatureFlagScope @default(GLOBAL)
  companyId String?
  planId    String?
  enabled   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan?    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([code, scope, companyId, planId])
  @@map("feature_flags")
}

// ────────────────────────────── USAGE ────────────────────────────────────

model Job {
  id              String    @id @default(cuid())
  companyId       String
  userId          String?
  deviceId        String?
  templateId      String?
  outputCount     Int       @default(0)
  status          JobStatus @default(PROCESSING)
  errorMessage    String?
  appVersion      String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  processingTimeMs Int?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  device   Device?   @relation(fields: [deviceId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([startedAt])
  @@map("jobs")
}

// ────────────────────────────── SUPPORT ──────────────────────────────────

model SupportTicket {
  id          String         @id @default(cuid())
  companyId   String
  userId      String
  subject     String
  category    String
  priority    TicketPriority @default(MEDIUM)
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id])
  replies SupportTicketReply[]

  @@index([companyId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketReply {
  id             String   @id @default(cuid())
  ticketId       String
  authorUserId   String
  isAdminReply   Boolean  @default(false)
  message        String   @db.Text
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorUserId], references: [id])

  @@map("support_ticket_replies")
}

// ────────────────────────────── AUDIT ────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // acting user (admin or self-service action)
  companyId String?  // affected company, if applicable
  action    String   // e.g. "PLAN_CHANGED", "LICENSE_SUSPENDED"
  entity    String   // e.g. "Subscription", "License"
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ────────────────────────────── RATE LIMITING ────────────────────────────

// Backs brute-force protection (PART 53) for login, registration, and
// password-reset requests. Deliberately DB-backed rather than an in-memory
// map: serverless functions (Vercel) don't share memory across instances,
// so an in-memory counter would silently under-count. Phase 7's note in
// docs/ARCHITECTURE.md flags swapping this for Redis/Upstash once traffic
// justifies it — the call sites (src/lib/rate-limit.ts) won't need to
// change, only this model's backing implementation.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String   // e.g. "login:email:demo@company.com" or "login:ip:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_attempts")
}
