# ─────────────────────────────────────────────────────────────
# MCloud Adapt Pilot — Environment Variables (EXAMPLE FILE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---------------------------------------------
# Local dev example (if you run Postgres via Docker, see README):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcloud_adapt_pilot?schema=public"
# Hosted dev example (Neon / Supabase / Railway) — use the connection
# string they give you, it will look similar to this:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# --- App / URLs ----------------------------------------------------------
# Base URL this app is served from. Used to build absolute links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js / NextAuth ----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Razorpay (Phase 6) -----------------------------------------------------
# From https://dashboard.razorpay.com/app/keys (use TEST mode keys first)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# From Razorpay Dashboard → Settings → Webhooks. Point the webhook URL at
# {NEXT_PUBLIC_APP_URL}/api/v1/webhooks/razorpay and subscribe at least to
# payment.captured, payment.failed, and refund.processed.
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Transactional Email (Phase 3/58) --------------------------------------
# Any SMTP provider works (Resend, Postmark, SES, Mailgun...). Fill in
# when Phase 3 (email verification / password reset) is implemented.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="replace-me"
EMAIL_FROM="MCloud Adapt Pilot <no-reply@mediacloud.studio>"

# --- License / Token signing (Phase 7) -------------------------------------
# Used to sign short-lived device authorization / offline tokens.
# Generate with: openssl rand -base64 48
LICENSE_TOKEN_SIGNING_SECRET="replace-with-a-random-48-byte-secret"
# How long an offline device token stays valid before the desktop app
# must re-validate online. 24-48 is the recommended range.
LICENSE_TOKEN_TTL_HOURS="48"

# --- File storage for installers / assets (Phase 8/59) ---------------------
# Any S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"

# --- Environment marker ------------------------------------------------------
NODE_ENV="development"
